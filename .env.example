# === Авторизация ===
# Client ID OAuth-приложения Яндекса (https://oauth.yandex.ru/ → «Создать OAuth-приложение»).
# Используется для генерации ссылки авторизации в UI. Client Secret при implicit-флоу НЕ нужен.
YANDEX_CLIENT_ID=your-client-id-here

# Токен Яндекс Диска (необязательно: если указан, диск подключится автоматически при старте)
# YANDEX_TOKEN=y0_AgAAAA...

# === Настройки выгрузки ===
# Папка назначения по умолчанию на локальном диске (по умолчанию ./downloads в корне проекта).
DOWNLOAD_ROOT=./downloads

# Сколько файлов скачивать параллельно (число асинхронных воркеров).
DOWNLOAD_CONCURRENCY=8

# Лимит запросов к API Яндекс Диска, запросов/сек.
API_QPS=8

# Принудительный IPv4 (1 для включения, 0 для выключения).
FORCE_IPV4=1

# === Сервер ===
HOST=127.0.0.1
PORT=8080
